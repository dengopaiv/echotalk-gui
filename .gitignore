# Build outputs
build/
*.o
*.exe
*.dll
*.so

# Generated audio from test runs
*.wav

# Local Claude Code settings (machine-specific, not shared)
.claude/settings.local.json
out/

# Scratch space -- either of us may leave anything here
tmp/

# NVDA add-on staging: binaries and the proprietary Textalker images that
# get copied in before packaging. The driver source itself IS tracked.
nvda-addon/synthDrivers/echotalk/*.bin
nvda-addon/synthDrivers/echotalk/THIRD_PARTY_LICENSES.txt
nvda-addon/*.nvda-addon
