// echotalk_gui.rc - resources for the EchoTalk GUI.

#include <windows.h>
#include "resource.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "echotalk_gui.manifest"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION     0,1,0,0
  PRODUCTVERSION  0,1,0,0
  FILEFLAGSMASK   0x3fL
  FILEFLAGS       0x0L
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "EchoTalk GUI - emulated Echo II"
            VALUE "FileVersion",     "0.1.0.0"
            VALUE "InternalName",    "echotalk_gui"
            VALUE "OriginalFilename","echotalk_gui.exe"
            VALUE "ProductName",     "EchoTalk GUI"
            VALUE "ProductVersion",  "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
